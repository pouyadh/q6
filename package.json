{
  "name": "android.device.tweak",
  "module": "src/index.ts",
  "main": "dist/index.js",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/electron": "^1.6.12",
    "@types/node": "^26.6.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "ts-loader": "^9.6.2",
    "tsc": "^2.0.4"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --external electron --sourcemap=linked",
    "start": "bun run build && electron dist/index.js",
    "make": "rm -rf release && bun run build && electron-builder --win nsis"
  },
  "dependencies": {
    "ctrlc-wrapper": "^0.0.5",
    "tsx": "^4.23.12"
  },
  "build": {
    "appId": "com.pds.android.device.tweak",
    "productName": "Android Device Tweak",
    "win": {
      "icon": "tray.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Android Device Tweak",
      "installerIcon": "tray.ico",
      "uninstallerIcon": "tray.ico",
      "installerHeaderIcon": "tray.ico",
      "include": "installer.nsh",
      "installerLanguages": "en-US",
      "guid": "com.pds.android.device.tweak"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "!node_modules/electron/**/*",
      "tray.png",
      "index.html"
    ],
    "directories": {
      "output": "release"
    },
    "compression": "store"
  }
}
