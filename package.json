{
  "name": "q6",
  "module": "src/index.ts",
  "main": "dist/index.js",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/electron": "^1.6.12",
    "@types/node": "^26.3.0",
    "electron-builder": "^26.15.3",
    "ts-loader": "^9.6.2",
    "tsc": "^2.0.4",
    "electron": "^44.0.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --external electron",
    "start": "bun run build && electron dist/index.js",
    "make" : "rm -rf release && bun run build && electron-builder --win portable" 
  },
  "dependencies": {
    "tsx": "^4.23.12"
  },
  "build": {
    "appId": "com.pds.q6",
    "productName": "Q6",
    "win": {
      "icon" : "tray.ico",
      "target": "portable"
    },
    "files": [
      "dist/**/*",              
      "node_modules/**/*",
      "!node_modules/electron/**/*",
      "tray.png",
      "index.html"
    ],
    "directories": {
      "output": "release"
    },
    "compression": "store"
  }
}
